# Dependencies
node_modules/

# Environment secrets
.env

# Build output
dist/

# Reports (generated at runtime)
reports/
test-results/

# Agent-generated artifacts (review copies — not for source control)
generated/

# Screenshots & videos (generated at runtime)
*.png
*.mp4
*.webm

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# TypeScript
*.js.map
*.d.ts

# Logs
*.log
logs/

# Kiro AI internal (not for source control)
.kiro/

# Playwright MCP snapshots (generated at runtime)
.playwright-mcp/

# Test baselines (optional - uncomment if you want to track baselines)
# test-baselines/

# Allure
.allure/

# OS files
Thumbs.db

# Dev application source repo (cloned for source-repo scanning — not for source control)
.devrepo/

# ─── Secrets (bulletproof — never commit any real .env) ───────────────────────
# .env is matched above; be explicit about nested/variant env files too.
.env
.env.*
!.env.example
features/.env
**/.env
**/*.env
# but always allow the safe template
!**/.env.example

# ─── Non-execution / scratch files (not needed to run the framework) ──────────
# Stale duplicate knowledge bank (active bank lives in src/agents/knowledge/)
KB/
# Stray/backup properties copy (real one is src/pages/properties/)
others/
# Visual-testing baselines (regenerated; large binaries)
test-baselines/
# Ad-hoc scripts
test-upload.sh
# Source-index cache (regenerated from the dev repo each run)
source-index.json
generated/source-index.json
